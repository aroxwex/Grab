<Window x:Class="Grab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Grab.Controls"
        Title="Grab" Icon="Assets/icon.ico"
        Width="1080" Height="720" MinWidth="960" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar: brand, one box for everything, settings -->
            <Grid x:Name="TopBar" Grid.Row="0" Margin="20,14,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Grab" FontSize="20" FontWeight="Bold" Margin="10,0,20,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Border x:Name="Omnibox" Grid.Column="1" Style="{StaticResource Card}" Height="44" CornerRadius="12">
                    <Grid Margin="14,0,7,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="UrlBox" Style="{StaticResource BareTextBox}" FontSize="14"
                                     TextChanged="UrlBox_TextChanged" KeyDown="UrlBox_KeyDown" VerticalAlignment="Center"/>
                            <TextBlock Text="Paste a link, or type to search YouTube" IsHitTestVisible="False"
                                       Foreground="{StaticResource DimBrush}" FontSize="14" VerticalAlignment="Center" Margin="2,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=UrlBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock x:Name="OmniHint" Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                   Margin="0,0,10,0" Visibility="Collapsed"/>
                        <Button x:Name="BtnPaste" Grid.Column="3" Style="{StaticResource PillPrimary}" Height="30" Padding="12,0"
                                Click="Paste_Click" ToolTip="Paste from the clipboard (link or file)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Paste" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnOpenFile" Grid.Column="4" Style="{StaticResource PillButton}" Height="30" Padding="12,0" Margin="6,0,0,0"
                                Click="OpenFile_Click" ToolTip="Open a video or audio file from your computer">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Open file" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Button x:Name="BtnSettings" Grid.Column="2" Content="&#xE713;" Margin="12,0,0,0" Width="44" Height="44"
                        FontFamily="{StaticResource IconFont}" FontSize="18" Padding="0"
                        ToolTip="Settings" Click="Settings_Click"/>
            </Grid>

            <TextBlock x:Name="ErrorText" Grid.Row="1" FontSize="12.5" Margin="26,0,26,10" TextWrapping="Wrap" Visibility="Collapsed"/>

            <!-- Main content -->
            <Grid x:Name="MainGrid" Grid.Row="2" Margin="20,0,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="ColSpacer" Width="16"/>
                    <ColumnDefinition x:Name="ColRight" Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- Left: results / player + trim -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="PreviewBox" Grid.Row="0" Background="#070707" CornerRadius="16"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" MinHeight="200"
                            MouseLeftButtonDown="Preview_Down" MouseLeftButtonUp="Preview_Click" SizeChanged="PreviewBox_SizeChanged">
                        <Grid>
                            <Image x:Name="ThumbImage" Stretch="Uniform" Visibility="Collapsed"/>
                            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                          ScrubbingEnabled="True" Stretch="Uniform" Visibility="Collapsed"
                                          MediaOpened="Player_MediaOpened" MediaFailed="Player_MediaFailed"
                                          MediaEnded="Player_MediaEnded"/>

                            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="Assets/logo.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="What are we grabbing?" FontSize="18" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,16,0,6"/>
                                <TextBlock Text="Paste a link, search YouTube, or drop a video file anywhere."
                                           Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                    <Border Style="{StaticResource Card}" CornerRadius="9" Padding="10,5" Margin="0,0,8,0" Background="{StaticResource PanelBrush}">
                                        <TextBlock Text="Watch it first" Style="{StaticResource Muted}"/>
                                    </Border>
                                    <Border Style="{StaticResource Card}" CornerRadius="9" Padding="10,5" Margin="0,0,8,0" Background="{StaticResource PanelBrush}">
                                        <TextBlock Text="Trim visually" Style="{StaticResource Muted}"/>
                                    </Border>
                                    <Border Style="{StaticResource Card}" CornerRadius="9" Padding="10,5" Background="{StaticResource PanelBrush}">
                                        <TextBlock Text="Volume · MP4 · MP3" Style="{StaticResource Muted}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" Padding="12" Visibility="Collapsed">
                                <StackPanel x:Name="ResultsList"/>
                            </ScrollViewer>

                            <Border x:Name="PlayOverlay" Width="64" Height="64" CornerRadius="32" Background="#AA000000"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </Border>

                            <Button x:Name="BtnLoadPlayer" Style="{StaticResource PillPrimary}" Content="Load player"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,0" Visibility="Collapsed"
                                    ToolTip="Download a small copy so you can watch and trim visually" Click="LoadPlayer_Click"/>

                            <Border x:Name="PreviewStatusBox" Background="#CC000000" CornerRadius="8" Padding="10,5"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Visibility="Collapsed">
                                <TextBlock x:Name="PreviewStatus" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid x:Name="InfoPanel" Grid.Row="1" Margin="4,10,4,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MetaText" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnBack" Grid.Column="1" Style="{StaticResource SmallButton}" Margin="12,0,0,0"
                                VerticalAlignment="Center" Visibility="Collapsed" Click="Back_Click" ToolTip="Back to the search results">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="Results" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border x:Name="TimelineCard" Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0"
                            Padding="12,8,12,8" CornerRadius="12" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnPlay" Style="{StaticResource PlayButton}" Content="&#xE768;"
                                        Width="30" Height="30" FontSize="11" Click="Play_Click"/>
                                <TextBlock x:Name="TimeText" Grid.Column="1" Text="0:00 / 0:00" Margin="10,0,0,0" FontSize="12.5"
                                           VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnShot" Content="&#xE722;" Style="{StaticResource IconButton}"
                                            Width="28" Height="28" FontSize="13"
                                            ToolTip="Save a screenshot of this frame (S)" Click="Screenshot_Click"/>
                                    <Button x:Name="BtnPreviewMute" Content="&#xE767;" Style="{StaticResource IconButton}"
                                            Width="28" Height="28" FontSize="13"
                                            ToolTip="Mute the player" Click="PreviewMute_Click"/>
                                    <Button x:Name="BtnFullscreen" Content="&#xE740;" Style="{StaticResource IconButton}"
                                            Width="28" Height="28" FontSize="13" Margin="2,0,14,0"
                                            ToolTip="Full screen (F)" Click="Fullscreen_Click"/>
                                    <TextBlock Text="Trim" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <CheckBox x:Name="TrimSwitch" Style="{StaticResource Switch}" Click="TrimSwitch_Click"/>
                                </StackPanel>
                            </Grid>

                            <c:TrimTimeline x:Name="TrimBar" Height="36" Margin="0,4,0,0"/>

                            <Grid x:Name="TrimFields" Margin="0,6,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Start" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="StartBox" Grid.Column="1" Width="90" Height="32" FontSize="13" Padding="10,0"
                                         LostFocus="TrimBox_Commit" KeyDown="TrimBox_KeyDown"/>
                                <Button x:Name="BtnSetStart" Grid.Column="2" Content="Set here" Style="{StaticResource SmallButton}"
                                        Margin="6,0,18,0" ToolTip="Use the playhead position  ( [ )" Click="SetStart_Click"/>
                                <TextBlock Grid.Column="3" Text="End" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="EndBox" Grid.Column="4" Width="90" Height="32" FontSize="13" Padding="10,0"
                                         LostFocus="TrimBox_Commit" KeyDown="TrimBox_KeyDown"/>
                                <Button x:Name="BtnSetEnd" Grid.Column="5" Content="Set here" Style="{StaticResource SmallButton}"
                                        Margin="6,0,0,0" ToolTip="Use the playhead position  ( ] )" Click="SetEnd_Click"/>
                                <Button x:Name="BtnAddPart" Grid.Column="6" Content="+ Add part" Style="{StaticResource SmallButton}"
                                        HorizontalAlignment="Left" Margin="18,0,0,0"
                                        ToolTip="Keep this range and pick another one. All kept parts are joined in the order you add them."
                                        Click="AddPart_Click"/>
                                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Length" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="LengthText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentLightBrush}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="PartsBox" Margin="0,8,0,0" Visibility="Collapsed">
                                <Grid>
                                    <TextBlock Text="KEPT PARTS (JOINED IN THIS ORDER)" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                                    <Button Content="Clear" Style="{StaticResource GhostButton}" Padding="8,0" FontSize="11.5"
                                            HorizontalAlignment="Right" Margin="0,-6,-8,0" Click="ClearParts_Click"/>
                                </Grid>
                                <WrapPanel x:Name="PartsPanel"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Right: output options -->
                <Border x:Name="RightPanel" Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="OptionsScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="18,16,18,6">
                            <StackPanel>
                                <TextBlock Text="SAVE AS" Style="{StaticResource SectionLabel}"/>
                                <Border Style="{StaticResource SegHost}">
                                    <UniformGrid Rows="1">
                                        <RadioButton x:Name="RbVideo" GroupName="mode" Content="Video" IsChecked="True"
                                                     Style="{StaticResource SegButton}" Click="Mode_Click"/>
                                        <RadioButton x:Name="RbAudio" GroupName="mode" Content="Audio"
                                                     Style="{StaticResource SegButton}" Click="Mode_Click"/>
                                    </UniformGrid>
                                </Border>

                                <StackPanel x:Name="ResSection" Margin="0,18,0,0">
                                    <TextBlock Text="RESOLUTION" Style="{StaticResource SectionLabel}"/>
                                    <WrapPanel x:Name="ResPanel"/>
                                    <TextBlock x:Name="ResEmpty" Text="Resolutions show up here once a video is loaded."
                                               Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel x:Name="VideoFormatSection" Margin="0,10,0,0">
                                    <TextBlock Text="FORMAT" Style="{StaticResource SectionLabel}"/>
                                    <Border Style="{StaticResource SegHost}">
                                        <UniformGrid Rows="1">
                                            <RadioButton x:Name="RbMp4" GroupName="vfmt" Content="MP4" IsChecked="True" Tag="mp4"
                                                         Style="{StaticResource SegButton}" Click="VideoFormat_Click"/>
                                            <RadioButton x:Name="RbMkv" GroupName="vfmt" Content="MKV" Tag="mkv"
                                                         Style="{StaticResource SegButton}" Click="VideoFormat_Click"/>
                                            <RadioButton x:Name="RbWebm" GroupName="vfmt" Content="WebM" Tag="webm"
                                                         Style="{StaticResource SegButton}" Click="VideoFormat_Click"/>
                                        </UniformGrid>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="AudioFormatSection" Margin="0,18,0,0" Visibility="Collapsed">
                                    <TextBlock Text="FORMAT" Style="{StaticResource SectionLabel}"/>
                                    <Border Style="{StaticResource SegHost}">
                                        <UniformGrid Rows="1">
                                            <RadioButton x:Name="RbMp3" GroupName="afmt" Content="MP3" IsChecked="True" Tag="mp3"
                                                         Style="{StaticResource SegButton}" Click="AudioFormat_Click"/>
                                            <RadioButton x:Name="RbM4a" GroupName="afmt" Content="M4A" Tag="m4a"
                                                         Style="{StaticResource SegButton}" Click="AudioFormat_Click"/>
                                            <RadioButton x:Name="RbOpus" GroupName="afmt" Content="Opus" Tag="opus"
                                                         Style="{StaticResource SegButton}" Click="AudioFormat_Click"/>
                                            <RadioButton x:Name="RbWav" GroupName="afmt" Content="WAV" Tag="wav"
                                                         Style="{StaticResource SegButton}" Click="AudioFormat_Click"/>
                                        </UniformGrid>
                                    </Border>
                                    <StackPanel x:Name="BitrateSection" Margin="0,10,0,0">
                                        <TextBlock Text="QUALITY" Style="{StaticResource SectionLabel}"/>
                                        <Border Style="{StaticResource SegHost}">
                                            <UniformGrid Rows="1">
                                                <RadioButton x:Name="Rb128" GroupName="abr" Content="128 kbps" Tag="128"
                                                             Style="{StaticResource SegButton}" Click="Bitrate_Click"/>
                                                <RadioButton x:Name="Rb192" GroupName="abr" Content="192 kbps" Tag="192"
                                                             Style="{StaticResource SegButton}" Click="Bitrate_Click"/>
                                                <RadioButton x:Name="Rb320" GroupName="abr" Content="320 kbps" Tag="320" IsChecked="True"
                                                             Style="{StaticResource SegButton}" Click="Bitrate_Click"/>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel x:Name="VolumeSection" Margin="0,18,0,0">
                                    <Grid>
                                        <TextBlock Text="VOLUME" Style="{StaticResource SectionLabel}"/>
                                        <Button x:Name="BtnVolReset" Content="Reset" Style="{StaticResource GhostButton}" Padding="8,2"
                                                FontSize="11.5" HorizontalAlignment="Right" Margin="0,-6,-8,0" Click="VolReset_Click"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="VolSlider" Minimum="0" Maximum="200" Value="100" SmallChange="1" LargeChange="10"
                                                TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource GrabSlider}"
                                                VerticalAlignment="Center" ValueChanged="VolSlider_ValueChanged"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBox x:Name="VolBox" Width="72" Height="34" Text="100" FontSize="14" Padding="12,0"
                                                     LostFocus="VolBox_Commit" KeyDown="VolBox_KeyDown"/>
                                            <TextBlock Text="%" Style="{StaticResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="VolHint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="100% is the original volume. 0% removes the sound."/>
                                </StackPanel>

                                <Grid x:Name="FastRow" Margin="0,18,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Fast cut" FontWeight="SemiBold"/>
                                        <TextBlock Text="No re-encoding: instant, but the cut can start a moment early"
                                                   Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox x:Name="FastSwitch" Grid.Column="1" Style="{StaticResource Switch}"/>
                                </Grid>

                                <Border Height="1" Background="{StaticResource LineSoftBrush}" Margin="0,18,0,14"/>

                                <TextBlock Text="SAVE TO" Style="{StaticResource SectionLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DirText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <Button x:Name="BtnChangeDir" Grid.Column="1" Content="Change" Style="{StaticResource SmallButton}"
                                            Margin="10,0,0,0" Click="ChangeDir_Click"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Action area -->
                        <Grid Grid.Row="1" Margin="18,10,18,16">
                            <Button x:Name="BtnGo" Content="Download" Style="{StaticResource PrimaryButton}" Click="Go_Click"
                                    IsEnabled="False"/>

                            <Grid x:Name="ProgressPanel" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ProgTrack" Height="56" CornerRadius="12" Background="{StaticResource Panel2Brush}"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1" SizeChanged="ProgTrack_SizeChanged">
                                    <Grid>
                                        <Border x:Name="ProgFill" HorizontalAlignment="Left" Width="0" CornerRadius="11"
                                                Background="{StaticResource AccentSoftBrush}"/>
                                        <StackPanel Margin="14,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="ProgText" Text="Starting…" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="ProgInfo" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Button x:Name="BtnCancel" Grid.Column="1" Content="Cancel" Margin="10,0,0,0" Padding="18,0"
                                        Click="Cancel_Click"/>
                            </Grid>

                            <Border x:Name="DonePanel" Style="{StaticResource Card}" Background="{StaticResource Panel2Brush}"
                                    Padding="14,12" Visibility="Collapsed">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                   Foreground="{StaticResource AccentLightBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Saved" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DoneFile" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                               Margin="26,2,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnShow" Content="Show in folder" Click="Show_Click"/>
                                        <Button x:Name="BtnAgain" Grid.Column="2" Content="Grab another" Click="Again_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>

        <!-- Settings overlay -->
        <Grid x:Name="SettingsOverlay" Background="#CC000000" Visibility="Collapsed" MouseLeftButtonDown="SettingsBackdrop_Click">
            <Border Style="{StaticResource Card}" Width="500" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}" MouseLeftButtonDown="SettingsCard_Click">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
                    <StackPanel Margin="0,0,4,0">
                        <Grid>
                            <TextBlock Text="Settings" FontSize="17" FontWeight="Bold"/>
                            <Button Content="&#xE711;" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                                    Width="32" Height="32" Click="SettingsClose_Click"/>
                        </Grid>

                        <TextBlock Text="PLAYER" Style="{StaticResource SectionLabel}" Margin="0,20,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="Load the player automatically" FontWeight="SemiBold"/>
                                <TextBlock Text="Downloads a small 360p copy of each video so you can watch it and trim visually. Turn this off to skip it; you can still load it with one click."
                                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoPreviewSwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="AutoPreview_Click"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <TextBlock x:Name="TempText" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Button x:Name="BtnClearTemp" Content="Clear now" Style="{StaticResource SmallButton}"
                                    HorizontalAlignment="Right" Click="ClearTemp_Click"/>
                        </Grid>

                        <TextBlock Text="COOKIES" Style="{StaticResource SectionLabel}" Margin="0,22,0,8"/>
                        <TextBlock Text="Only needed for videos that require a login (age-restricted, members-only, or a &quot;confirm you're not a bot&quot; message). Leave this off otherwise."
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Border Style="{StaticResource SegHost}">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="RbCkNone" GroupName="ck" Content="Off" Tag="" IsChecked="True"
                                             Style="{StaticResource SegButton}" Click="Cookies_Click"/>
                                <RadioButton x:Name="RbCkFirefox" GroupName="ck" Content="Firefox" Tag="firefox"
                                             Style="{StaticResource SegButton}" Click="Cookies_Click"/>
                                <RadioButton x:Name="RbCkChrome" GroupName="ck" Content="Chrome" Tag="chrome"
                                             Style="{StaticResource SegButton}" Click="Cookies_Click"/>
                                <RadioButton x:Name="RbCkEdge" GroupName="ck" Content="Edge" Tag="edge"
                                             Style="{StaticResource SegButton}" Click="Cookies_Click"/>
                                <RadioButton x:Name="RbCkBrave" GroupName="ck" Content="Brave" Tag="brave"
                                             Style="{StaticResource SegButton}" Click="Cookies_Click"/>
                            </UniformGrid>
                        </Border>
                        <TextBlock Text="Chrome, Edge and Brave often can't be read anymore. Firefox works more reliably. If cookies fail, Grab retries without them automatically."
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <TextBlock Text="Or use a cookies.txt file: sign in to the site in your browser, export your cookies to a .txt file with a &quot;cookies.txt&quot; browser extension, then choose that file here. Keep the file private, it works like a saved login."
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CookiesFileText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource Muted}"/>
                            <Button x:Name="BtnCookiesFile" Grid.Column="1" Content="Choose cookies.txt…" Style="{StaticResource SmallButton}"
                                    Margin="10,0,0,0" Click="CookiesFile_Click"/>
                            <Button x:Name="BtnCookiesClear" Grid.Column="2" Content="Clear" Style="{StaticResource SmallButton}"
                                    Margin="6,0,0,0" Click="CookiesClear_Click"/>
                        </Grid>

                        <TextBlock Text="DOWNLOAD ENGINE" Style="{StaticResource SectionLabel}" Margin="0,22,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="YtVersionText" Text="yt-dlp"/>
                                <TextBlock x:Name="FfmpegText" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnUpdate" Grid.Column="1" Content="Update yt-dlp" Style="{StaticResource SmallButton}"
                                    VerticalAlignment="Center" Click="Update_Click"/>
                        </Grid>
                        <TextBlock x:Name="UpdateMsg" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="Collapsed"/>
                        <TextBlock Text="If downloads stop working because a site changed, updating yt-dlp usually fixes it."
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <TextBlock Text="SHORTCUTS" Style="{StaticResource SectionLabel}" Margin="0,22,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="Space"/><TextBlock Text="F"/><TextBlock Text="S"/><TextBlock Text="← →"/>
                                <TextBlock Text="[   ]"/><TextBlock Text="Esc"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Play / pause" Style="{StaticResource Muted}" FontSize="13"/>
                                <TextBlock Text="Full screen" Style="{StaticResource Muted}" FontSize="13"/>
                                <TextBlock Text="Save a screenshot of the current frame" Style="{StaticResource Muted}" FontSize="13"/>
                                <TextBlock Text="Seek 1 second (hold Shift for 5)" Style="{StaticResource Muted}" FontSize="13"/>
                                <TextBlock Text="Set the trim start / end at the playhead" Style="{StaticResource Muted}" FontSize="13"/>
                                <TextBlock Text="Leave full screen or close this window" Style="{StaticResource Muted}" FontSize="13"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{StaticResource LineSoftBrush}" Margin="0,22,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="Assets/logo.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Grab" FontWeight="Bold" FontSize="14"/>
                                <TextBlock x:Name="AboutText" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="GitHub" Style="{StaticResource SmallButton}" Margin="0,0,6,6"
                                    ToolTip="Open the project page" Click="GitHub_Click"/>
                            <Button Content="Report a problem" Style="{StaticResource SmallButton}" Margin="0,0,6,6"
                                    Click="Issues_Click"/>
                            <Button Content="Open last log" Style="{StaticResource SmallButton}" Margin="0,0,6,6" Click="OpenLog_Click"
                                    ToolTip="Shows what yt-dlp / ffmpeg printed during the last run"/>
                            <Button Content="Open app folder" Style="{StaticResource SmallButton}" Margin="0,0,0,6"
                                    Click="OpenAppFolder_Click"/>
                        </WrapPanel>
                        <TextBlock Text="Open source, MIT License. Powered by yt-dlp and FFmpeg." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
