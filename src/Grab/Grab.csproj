<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Grab</AssemblyName>
    <RootNamespace>Grab</RootNamespace>
    <Product>Grab</Product>
    <Version>1.0.0</Version>
    <Authors>aroxwex</Authors>
    <Company>aroxwex</Company>
    <Description>Grab - download, trim and convert video and audio.</Description>
    <Copyright>Copyright (c) 2026 aroxwex</Copyright>
    <RepositoryUrl>https://github.com/aroxwex/Grab</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>
